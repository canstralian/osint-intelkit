# PostgreSQL Configuration
POSTGRES_URL=postgresql://osint:osintpass@postgres:5432/osintdb
POSTGRES_DB=osintdb
POSTGRES_USER=osint
POSTGRES_PASSWORD=osintpass

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpass

# API Keys (IMPORTANT: Never commit real keys to version control)
# Obtain keys from respective service providers
# VirusTotal: https://www.virustotal.com/gui/my-apikey
# Shodan: https://account.shodan.io/
API_KEY_VT=your_virustotal_api_key_here
API_KEY_SHODAN=your_shodan_api_key_here

# Rate Limiting Configuration
VT_RATE_LIMIT=4  # requests per minute (free tier)
SHODAN_RATE_LIMIT=1  # requests per second

# Prefect Configuration
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_LOGGING_LEVEL=INFO

# Prefect Scheduling Configuration
# Schedule type: "interval" or "cron"
OSINT_SCHEDULE_TYPE=interval

# For interval scheduling: how many hours between runs
OSINT_SCHEDULE_INTERVAL_HOURS=4

# For cron scheduling: cron expression (e.g., "0 2 * * *" for 2 AM daily)
OSINT_SCHEDULE_CRON=0 2 * * *
OSINT_SCHEDULE_TIMEZONE=UTC

# Seed domains for scheduled collection (comma-separated)
# IMPORTANT: Only include authorized targets you have permission to scan
OSINT_SEED_DOMAINS=example.com

# Optional: Enable additional scheduled deployments
ENABLE_HOURLY_SCAN=false
ENABLE_DAILY_SCAN=false

# Application Settings
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=true
MAX_CONCURRENT_ENRICHMENTS=5

# Authorization and Scope Control
# IMPORTANT: Only use for authorized targets
AUTHORIZED_DOMAINS=example.com,yourdomain.com
SCOPE_FILE=/app/scope.txt
